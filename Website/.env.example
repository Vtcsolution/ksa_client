# Database
DATABASE_URL="postgresql://user:password@localhost:5432/omnira"

# Next Auth
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Payment (Moyasar)
MOYASAR_API_KEY="your-moyasar-api-key"
MOYASAR_SECRET="your-moyasar-secret"

# SMS (Unifonic)
UNIFONIC_API_ID="your-unifonic-api-id"
UNIFONIC_SENDER_ID="your-sender-id"

# Email (Resend) — used by the email marketing campaign sender (lib/marketing/emailProvider.ts).
# Optional: if unset, campaigns still build their audience and queue every recipient for real,
# they just aren't handed to a provider yet — same "queue until connected" pattern as WhatsApp.
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="Omnira Valet <no-reply@omniravalet.com>"

# Email (SMTP) — alternative to Resend, e.g. a Hostinger mailbox. Only used
# if RESEND_API_KEY is unset. secure is inferred from the port (465 = SSL).
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="noreply@yourdomain.com"
SMTP_PASSWORD="your-mailbox-password"
SMTP_FROM="Omnira Valet <noreply@yourdomain.com>"

# OpenAI — used to flag low-rating feedback for staff attention (lib/feedback/aiFlag.ts).
# Optional: if unset, feedback is stored without AI analysis, no error.
OPENAI_API_KEY="your-openai-api-key"

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Analytics
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
